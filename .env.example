# Postgres (docker compose up -d starts one on port 55433)
DATABASE_URL=postgres://bechakena:bechakena@localhost:55433/bechakena

# Session/OTP hashing secret — use a long random string in production
AUTH_SECRET=change-me

# SMS gateway for OTP and customer messages: "console" (dev, prints codes) or "bulksmsbd" / "sslwireless"
SMS_DRIVER=console
SMS_API_KEY=
SMS_SENDER_ID=

# Uploaded images (logos, product photos): "local" (./uploads) or "s3"
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Subscription billing (FR-SUB-03). With nothing configured, a local sandbox checkout is used (never in production unless BILLING_ALLOW_SANDBOX=1).
APP_URL=
BILLING_VAT_PCT=5
BILLING_ALLOW_SANDBOX=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_LIVE=false
# No free plan: without a paid plan, documents can be printed for PRINT_QUOTA orders per device and per shop (default 5, never reset),
# and PRINT_QUOTA_IP per IP address (default 15 — looser because mobile carriers share IPs).
PRINT_QUOTA=5
PRINT_QUOTA_IP=15
# Protects /api/billing/cron (renewal reminders + lapsed-plan downgrades); call daily.
CRON_SECRET=

# --- Platform & messaging -------------------------------------------------
# AI order parsing (Claude). Without a key the rule-based parser is used.
ANTHROPIC_API_KEY=
AI_MONTHLY_CREDITS=500
# Meta (Messenger, Instagram, WhatsApp Cloud API) webhooks: /api/webhooks/meta
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
# Web push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bechakena.app
# Allow the "Add credits" sandbox top-up in production (normally billing adds credits)
SMS_SANDBOX_TOPUP=
# Scheduler: GET /api/cron/daily hourly (summaries) and /api/cron/daily?job=webhooks every minute,
# with "Authorization: Bearer $CRON_SECRET" (same CRON_SECRET as above).

# Scheduled jobs (courier status sync every 15–30 min, daily summary) call /api/cron/* with this bearer token
CRON_SECRET=

# Couriers: credentials are entered per shop in Settings → Couriers & payments (stored encrypted).
# Set to 1 to allow the test courier / test payment drivers in production.
COURIER_SANDBOX=
PAYMENTS_SANDBOX=
# Optional API base-URL overrides (bKash and Nagad default to their sandboxes)
STEADFAST_BASE_URL=
PATHAO_BASE_URL=
REDX_BASE_URL=
PAPERFLY_BASE_URL=
CARRYBEE_BASE_URL=
BKASH_BASE_URL=
NAGAD_BASE_URL=
