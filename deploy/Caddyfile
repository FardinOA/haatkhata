# Shop app. The admin API isn't reachable here: it only answers on the admin domain.
{$DOMAIN} {
	encode zstd gzip
	@admin path /api/admin /api/admin/*
	respond @admin 404
	reverse_proxy app:3000
}

# Admin console: its own static app, plus only the admin API, on its own cookie.
{$ADMIN_DOMAIN} {
	encode zstd gzip
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		X-Robots-Tag "noindex, nofollow"
	}
	handle /api/admin/* {
		reverse_proxy app:3000
	}
	handle /assets/* {
		root * /srv/admin
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/admin
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
