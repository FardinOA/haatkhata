# Copy to deploy/.env. Every other app setting from ../.env.example can go here too.
# The shop app and the admin console each get their own domain; point both at this server.
DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
POSTGRES_PASSWORD=change-me-long-random
AUTH_SECRET=change-me-long-random
CRON_SECRET=change-me-long-random

# Leave ANTHROPIC_API_KEY empty to run on the free order reader only (no AI bill).
ANTHROPIC_API_KEY=

# Uploads stay on the server's disk and are copied to the backup bucket nightly.
STORAGE_DRIVER=local

# Off-site backups: any S3-compatible bucket. Cloudflare R2: free up to 10 GB, no egress fees.
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=haatkhata-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_KEEP_DAYS=14

SMS_DRIVER=bulksmsbd
SMS_API_KEY=
SMS_SENDER_ID=
