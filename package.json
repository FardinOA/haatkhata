{
  "name": "bechakena-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-zxing.mjs",
    "dev": "next dev",
    "predev:https": "node scripts/copy-zxing.mjs",
    "dev:https": "next dev --experimental-https",
    "prebuild": "node scripts/copy-zxing.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --project unit",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local src/server/db/migrate.ts",
    "test:server": "vitest run --project server",
    "test:all": "vitest run",
    "admin:grant": "tsx --env-file=.env.local scripts/admin-grant.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "aws4fetch": "^1.0.20",
    "barcode-detector": "^3.2.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "html-to-image": "^1.11.13",
    "immer": "^11.2.9",
    "lenis": "1.3.27",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
